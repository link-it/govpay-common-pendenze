<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.gov4j.govpay</groupId>
        <artifactId>govpay-bom</artifactId>
        <version>2.0.5-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <artifactId>govpay-common-pendenze</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>GovPay Common Pendenze</name>
    <description>Libreria comune per la gestione delle pendenze nei moduli GovPay</description>
    <url>https://gov4j.org/maven/govpay/govpay-common-pendenze/1.0.0-SNAPSHOT</url>

    <scm>
        <connection>scm:git:https://github.com/link-it/govpay-common-pendenze.git</connection>
        <developerConnection>scm:git:git@github.com:link-it/govpay-common-pendenze.git</developerConnection>
        <url>https://github.com/link-it/govpay-common-pendenze</url>
    </scm>

    <repositories>
        <repository>
            <id>central-snapshots</id>
            <url>https://central.sonatype.com/repository/maven-snapshots</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <properties>
        <sonar.coverage.jacoco.xmlReportPaths>${project.basedir}/target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <!-- govpay-common (not in BOM) -->
        <govpay-common.version>2.0.4-SNAPSHOT</govpay-common.version>
    </properties>

    <dependencies>
        <!-- JPA: entita' e persistenza dell'aggregato pendenza -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- GovPay Common: utility condivise (es. IuvUtils, DateTimePatterns) -->
        <dependency>
            <groupId>org.gov4j.govpay</groupId>
            <artifactId>govpay-common</artifactId>
            <version>${govpay-common.version}</version>
        </dependency>

        <!-- Jackson 3: serializzazione dei campi JSON (proprieta' pendenza) -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Runtime JAXB per i modelli generati dai tracciati PagoPA (RT: ctRicevutaTelematica/
             ctReceipt/ctReceiptV2, vedi xsd/pagopa) — porta anche jakarta.xml.bind-api in modo
             transitivo. Stesso pattern di govpay-console-api. -->
        <dependency>
            <groupId>org.glassfish.jaxb</groupId>
            <artifactId>jaxb-runtime</artifactId>
        </dependency>

        <!-- Spring Boot Configuration Processor: metadati di PendenzeProperties -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Slice test JPA (@DataJpaTest, TestEntityManager) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- H2: schema reale caricato in memoria per i test di mapping -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Jacoco for code coverage -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>generate-code-coverage-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- OWASP Dependency Check (versione e config da BOM pluginManagement) -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
            </plugin>

            <!-- xjc: genera i bean JAXB dei tracciati PagoPA (RT) dalle XSD vendorizzate in
                 src/main/resources/xsd/pagopa. Stesso pattern/versione di govpay-console-api. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>jaxb2-maven-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>xjc-rpt-rt</id>
                        <goals>
                            <goal>xjc</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.basedir}/src/main/resources/xsd/pagopa/PagInf_RPT_RT_6_2_0.xsd</source>
                            </sources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>xjc-pafornode</id>
                        <goals>
                            <goal>xjc</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.basedir}/src/main/resources/xsd/pagopa/paForNode.xsd</source>
                            </sources>
                            <packageName>it.gov.pagopa.pagopa_api.pa.pafornode</packageName>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <xjbSources>
                        <xjbSource>${project.basedir}/src/main/resources/xsd/pagopa/global.xjb</xjbSource>
                    </xjbSources>
                    <extension>true</extension>
                    <clearOutputDir>false</clearOutputDir>
                </configuration>
            </plugin>

            <!-- Aggiunge le sorgenti xjc alla compilazione (stesso pattern di govpay-console-api) -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>add-source-xjc</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-sources/jaxb</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Aggiunge doclint override al profilo release ereditato dal BOM -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration>
                            <doclint>all,-missing</doclint>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
